{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "K3 StarryOS N Host-DWARF ARD",
      "type": "ardb",
      "request": "launch",
      "program": "${env:STARRYOS_WORKSPACE}/artifacts/starryos.elf",
      "cwd": "${env:STARRYOS_WORKSPACE}",
      "remote": "localhost:3333",
      "gdbPath": "gdb-multiarch",
      "enableOsDebug": false,
      "stopOnEntry": false
    }
  ]
}
