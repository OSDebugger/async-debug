# Copy this file to baseline.env. The copied file is ignored by Git.
# Keep the baseline outside this repository; do not copy firmware artifacts here.
# Uncomment and edit this boot-only path. Alternatively, export
# K3_DWARF_BASELINE before running boot_golden_flow.sh.
# K3_DWARF_BASELINE="$HOME/k3-baselines/K3_COM260_StarryOS_DWARF_Debug_Verified"

K3_UART_DEVICE=/dev/ttyUSB0
K3_UART_BAUD=115200
