# Copy this file to baseline.env. The copied file is ignored by Git.
# K3_DWARF_BASELINE 指向 async-os-original 工作区根目录(含 artifacts/k3-host-dwarf/)。
# 该工作区还需按下列布局放置固件(不进 git):
#   artifacts/fsbl/FSBL.bin                              Debug 版 FSBL(开 JTAG 的唯一入口)
#   artifacts/u-boot/k3-jtag-ram-opensbi-uboot.itb      OpenSBI + U-Boot 合体镜像
#   artifacts/k3-host-dwarf/asyncos.bin                 Host-DWARF 构建产物(scripts/k3_host_dwarf_build.sh)
#   artifacts/k3-host-dwarf/asyncos.elf                 同上(主机加载)
#   artifacts/k3-host-dwarf/k3.dtb                      板载 DTB(把固件包里的 spacemit-k3-com260-ifx.dtb 复制改名)
# 或者在运行 boot_golden_flow.sh 前 export K3_DWARF_BASELINE。
# K3_DWARF_BASELINE="/home/iris/data/async-os-original"

K3_UART_DEVICE=/dev/ttyUSB0
K3_UART_BAUD=115200
